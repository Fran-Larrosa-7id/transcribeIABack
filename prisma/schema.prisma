generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TranscriptionLanguage {
  auto
  es
  en
  pt
}

enum TranscriptionModel {
  economy
  high_accuracy
}

enum TranscriptionStatus {
  pending
  uploading
  processing_audio
  transcribing
  merging
  completed
  failed
}

model TranscriptionJob {
  id              String                @id @default(uuid())
  title           String
  originalFilename String
  storedFilename  String
  filePath        String
  mimeType        String
  fileSize        Int
  durationSeconds Int?
  language        TranscriptionLanguage
  model           TranscriptionModel
  fixPunctuation  Boolean               @default(false)
  generateSummary Boolean               @default(false)
  status          TranscriptionStatus    @default(pending)
  progress        Int                   @default(0)
  transcriptText  String?
  summary         String?
  errorMessage    String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  finishedAt      DateTime?

  @@index([createdAt])
  @@index([status])
}
